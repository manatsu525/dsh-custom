[Unit]
Description=Official DeepSeek Harness (dsh) behind HTTPS proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dsh-official-vps
EnvironmentFile=/opt/dsh-official-vps/config.env
ExecStart=/opt/dsh-official-vps/scripts/run.sh
Restart=on-failure
# Soft cap; pair with 1G swap on 512MB VPS
MemoryMax=450M

[Install]
WantedBy=multi-user.target
