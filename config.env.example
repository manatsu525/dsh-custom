# Copy to config.env and edit.

# Public host browsers use (VPS IP or domain). Required for remote HTTPS.
# Example: 203.0.113.10   or   harness.example.com
PUBLIC_HOST=YOUR_VPS_IP_OR_DOMAIN

# HTTPS listen (proxy). dsh itself stays on 127.0.0.1:3080
HTTPS_PORT=8443
DSH_PORT=3080

# Official harness home + API key (also configurable in the Web UI)
export DSH_HOME=/var/lib/dsh
export DEEPSEEK_API_KEY=
export DSH_TELEMETRY_DISABLED=1

# Cap V8 heap so a 512MB box does not OOM as easily (MB)
NODE_MAX_OLD_SPACE_SIZE=256

# Work tree root for "default workspace" (Documents override).
# Default workspace path becomes: $DOCUMENTS_DIRECTORY/deepseek-harness/default-workspace
# Prefer opening /home/share directly in the Web UI folder picker for an exact root.
DOCUMENTS_DIRECTORY=/home/share

# Gateway login session lifetime (seconds). Default 1 year.
# SESSION_MAX_AGE_SEC=31536000
